#pragma once

#include <factorial.h>

template <class T>
T factorial(T n) {
    if(1 < n) [[likely]]
        return n * factorial(n - 1);
    else if(0 == n || 1 == n) [[unlikely]]
        return 1;
    // Hacky DZ error. Jump straight to it and not waste time by doing x=(x-1)/(x-2)/... until zero division
    [[unlikely]] return 00 / 00;
}